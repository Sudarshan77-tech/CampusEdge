generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  COLLEGE_ADMIN
  SUPER_ADMIN

  @@map("role_enum")
}

enum CollegeStatus {
  PENDING
  ACTIVE
  SUSPENDED

  @@map("college_status_enum")
}

enum UserStatus {
  ONBOARDING
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_status_enum")
}

enum Degree {
  BTECH
  MTECH
  MCA
  MBA
  OTHER

  @@map("degree_enum")
}

enum SkillCategory {
  LANGUAGE
  FRAMEWORK
  DATABASE
  CS_FUNDAMENTAL
  TOOL

  @@map("skill_category_enum")
}

enum Proficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED

  @@map("proficiency_enum")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status_enum")
}

enum ConsentType {
  TERMS
  PRIVACY
  DATA_PROCESSING
  PLACEMENT_SHARING
  PERFORMANCE_SHARING

  @@map("consent_type_enum")
}

enum DataRequestType {
  EXPORT
  DELETE

  @@map("data_request_type_enum")
}

enum DataRequestStatus {
  OPEN
  IN_PROGRESS
  DONE
  REJECTED

  @@map("data_request_status_enum")
}

enum CompanyStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
  MERGED

  @@map("company_status_enum")
}

enum TopicCategory {
  APTITUDE
  VERBAL
  LOGICAL
  DSA
  PROGRAMMING
  DBMS
  SQL
  OS
  NETWORKS
  OOP
  SOFTWARE_ENGINEERING
  SYSTEM_DESIGN
  HR
  OTHER

  @@map("topic_category_enum")
}

enum DriveType {
  ON_CAMPUS
  OFF_CAMPUS
  POOL
  VIRTUAL

  @@map("drive_type_enum")
}

enum DriveCategory {
  MASS_RECRUITER
  REGULAR
  DREAM
  SUPER_DREAM

  @@map("drive_category_enum")
}

enum DriveStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("drive_status_enum")
}

enum JobType {
  FULL_TIME
  INTERNSHIP
  INTERN_PLUS_PPO

  @@map("job_type_enum")
}

enum RoundType {
  APTITUDE
  TECHNICAL_MCQ
  CODING
  GROUP_DISCUSSION
  TECHNICAL_INTERVIEW
  HR_INTERVIEW
  MANAGERIAL
  CASE_STUDY
  OTHER

  @@map("round_type_enum")
}

enum RoundMode {
  ONLINE
  OFFLINE

  @@map("round_mode_enum")
}

enum ApplicationStatus {
  REGISTERED
  WITHDRAWN
  SHORTLISTED
  SELECTED
  REJECTED

  @@map("application_status_enum")
}

enum NoticeAudience {
  ALL
  BY_BRANCH
  BY_BATCH_YEAR

  @@map("notice_audience_enum")
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("notice_status_enum")
}

enum ExperienceOutcome {
  SELECTED
  NOT_SELECTED
  NOT_DISCLOSED

  @@map("experience_outcome_enum")
}

enum ExperienceStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  UNDER_REVIEW
  REMOVED

  @@map("experience_status_enum")
}

enum ImportJobType {
  HISTORICAL_DRIVES
  APPLICATION_RESULTS
  QUESTIONS

  @@map("import_job_type_enum")
}

enum ImportJobStatus {
  UPLOADED
  VALIDATED
  FAILED
  COMMITTING
  COMPLETED

  @@map("import_job_status_enum")
}

model College {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String        @db.VarChar(255)
  slug                   String        @unique @db.VarChar(100)
  city                   String        @db.VarChar(100)
  state                  String        @db.VarChar(100)
  status                 CollegeStatus @default(PENDING)
  emailDomains           String[]      @default([]) @map("email_domains")
  requireStudentApproval Boolean       @default(false) @map("require_student_approval")
  enforceOneOfferPolicy  Boolean       @default(false) @map("enforce_one_offer_policy")
  contactEmail           String?       @map("contact_email") @db.VarChar(255)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  userProfiles        UserProfile[]
  auditLogs           AuditLog[]
  branches            Branch[]
  invitations         Invitation[]
  studentProfiles     StudentProfile[]
  studentSkills       StudentSkill[]
  placementSeasons    PlacementSeason[]
  drives              Drive[]
  driveRoles          DriveRole[]
  driveEligibilities  DriveEligibility[]
  driveRounds         DriveRound[]
  driveApplications   DriveApplication[]
  notices             Notice[]
  experiences         Experience[]
  importJobs          ImportJob[]
  questionGroups      QuestionGroup[]
  questions           Question[]
  questionBookmarks   QuestionBookmark[]
  testTemplates       TestTemplate[]
  testSchedules       TestSchedule[]
  attempts            Attempt[]
  attemptItems        AttemptItem[]
  attemptEvents       AttemptEvent[]
  studentTopicStats   StudentTopicStat[]
  readinessSnapshots  ReadinessSnapshot[]
  roadmapPlans        RoadmapPlan[]
  feedback            Feedback[]
  features                   CollegeFeature[]
  driveEvents                DriveEvent[]
  collegeEvents              CollegeEvent[]
  calendarFeedTokens         CalendarFeedToken[]
  companyFollows             CompanyFollow[]
  collegeCompanyNotes        CollegeCompanyNote[]
  prepResources              PrepResource[]
  interviewQuestions         InterviewQuestion[]
  interviewQuestionProgress  InterviewQuestionProgress[]
  studentCompanyScores       StudentCompanyScore[]
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  emailOutbox                EmailOutbox[]

  @@map("colleges")
}

model UserProfile {
  id        String     @id @db.Uuid
  collegeId String?    @map("college_id") @db.Uuid
  role      Role       @default(STUDENT)
  status    UserStatus @default(ONBOARDING)
  fullName  String     @map("full_name") @db.VarChar(255)
  email     String     @unique @db.VarChar(255)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  college                    College?             @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  studentProfile             StudentProfile?
  consents                   ConsentRecord[]
  dataRequests               DataRequest[]
  reviewedQuestions          Question[]           @relation("QuestionReviewer")
  authoredQuestionVersions   QuestionVersion[]    @relation("QuestionVersionAuthor")
  questionReports            QuestionReport[]
  questionBookmarks          QuestionBookmark[]
  attempts                   Attempt[]            @relation("StudentAttempts")
  voidedAttempts             Attempt[]            @relation("AttemptVoidedBy")
  studentTopicStats          StudentTopicStat[]
  readinessSnapshots         ReadinessSnapshot[]
  roadmapPlans               RoadmapPlan[]
  feedback                   Feedback[]
  enabledFeatures            CollegeFeature[]            @relation("FeatureEnabledBy")
  authoredCollegeEvents      CollegeEvent[]              @relation("CollegeEventAuthor")
  calendarFeedTokens         CalendarFeedToken[]
  collegeCompanyNotes        CollegeCompanyNote[]        @relation("CompanyNoteAuthor")
  createdPrepResources       PrepResource[]              @relation("PrepResourceAuthor")
  createdInterviewQuestions  InterviewQuestion[]         @relation("InterviewQuestionAuthor")
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  emailOutbox                EmailOutbox[]

  @@index([collegeId])
  @@map("user_profiles")
}

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId String   @map("college_id") @db.Uuid
  name      String   @db.VarChar(100)
  code      String   @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  college               College                @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  studentProfiles       StudentProfile[]
  driveEligibleBranches DriveEligibleBranch[]

  @@unique([collegeId, code])
  @@unique([id, collegeId])
  @@index([collegeId])
  @@map("branches")
}

model Invitation {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String           @db.VarChar(255)
  role       Role             @default(COLLEGE_ADMIN)
  collegeId  String           @map("college_id") @db.Uuid
  invitedBy  String           @map("invited_by") @db.Uuid
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([email])
  @@map("invitations")
}

model StudentProfile {
  userId                String    @id @map("user_id") @db.Uuid
  collegeId             String    @map("college_id") @db.Uuid
  branchId              String    @map("branch_id") @db.Uuid
  degree                Degree    @default(BTECH)
  batchYear             Int       @map("batch_year")
  cgpa                  Decimal   @db.Decimal(4, 2)
  activeBacklogs        Int       @default(0) @map("active_backlogs")
  enrollmentNumber      String?   @map("enrollment_number") @db.VarChar(50)
  targetRole            String?        @map("target_role") @db.VarChar(100)
  technicalTrack        TechnicalTrack @default(SOFTWARE) @map("technical_track")
  studyHoursPerDay      Decimal        @default(1.5) @map("study_hours_per_day") @db.Decimal(3, 1)
  targetDate            DateTime?      @map("target_date") @db.Timestamptz(6)
  onboardingCompletedAt DateTime?      @map("onboarding_completed_at") @db.Timestamptz(6)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  userProfile       UserProfile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  college           College            @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  branch            Branch             @relation(fields: [branchId, collegeId], references: [id, collegeId], onDelete: Restrict)
  studentSkills     StudentSkill[]
  driveApplications DriveApplication[]
  experiences       Experience[]
  companyFollows            CompanyFollow[]
  interviewQuestionProgress InterviewQuestionProgress[]
  studentCompanyScores      StudentCompanyScore[]

  @@unique([collegeId, enrollmentNumber])
  @@unique([userId, collegeId])
  @@index([collegeId])
  @@index([branchId])
  @@map("student_profiles")
}

model Skill {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String        @unique @db.VarChar(100)
  category  SkillCategory
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  studentSkills   StudentSkill[]
  driveRoleSkills DriveRoleSkill[]

  @@map("skills")
}

model StudentSkill {
  studentId   String      @map("student_id") @db.Uuid
  skillId     String      @map("skill_id") @db.Uuid
  collegeId   String      @map("college_id") @db.Uuid
  proficiency Proficiency @default(BEGINNER)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  studentProfile StudentProfile @relation(fields: [studentId, collegeId], references: [userId, collegeId], onDelete: Cascade)
  skill          Skill          @relation(fields: [skillId], references: [id], onDelete: Restrict)
  college        College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@id([studentId, skillId])
  @@index([collegeId])
  @@index([skillId])
  @@map("student_skills")
}

model ConsentRecord {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  driveId       String?     @map("drive_id") @db.Uuid
  consentType   ConsentType @map("consent_type")
  policyVersion String      @map("policy_version") @db.VarChar(20)
  ipAddress     String?     @map("ip_address") @db.VarChar(45)
  userAgent     String?     @map("user_agent") @db.Text
  granted       Boolean     @default(true)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  userProfile UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  drive       Drive?       @relation(fields: [driveId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([driveId])
  @@map("consent_records")
}

model DataRequest {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  type      DataRequestType
  status    DataRequestStatus @default(OPEN)
  handledBy String?           @map("handled_by") @db.Uuid
  handledAt DateTime?         @map("handled_at") @db.Timestamptz(6)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  userProfile UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("data_requests")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId  String?  @map("college_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  metadata   Json?    @db.JsonB
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  requestId  String?  @map("request_id") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  college College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)

  @@index([collegeId])
  @@index([actorId])
  @@map("audit_logs")
}

// =============================================================================
// Phase 2 Models
// =============================================================================

model Company {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String        @db.VarChar(255)
  normalizedName     String        @unique @map("normalized_name") @db.VarChar(255)
  slug               String        @unique @db.VarChar(100)
  website            String?       @db.VarChar(255)
  industry           String?       @db.VarChar(100)
  logoUrl            String?       @map("logo_url") @db.VarChar(500)
  status             CompanyStatus @default(PENDING_REVIEW)
  mergedIntoId       String?       @map("merged_into_id") @db.Uuid
  createdByCollegeId String?       @map("created_by_college_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  mergedInto  Company?     @relation("CompanyMerges", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom  Company[]    @relation("CompanyMerges")
  drives        Drive[]
  experiences   Experience[]
  testTemplates TestTemplate[]
  profile            CompanyProfile?
  follows            CompanyFollow[]
  collegeNotes       CollegeCompanyNote[]
  prepResources      PrepResource[]
  interviewQuestions InterviewQuestion[]
  studentScores      StudentCompanyScore[]

  @@index([status])
  @@map("companies")
}

model Topic {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String        @unique @db.VarChar(100)
  slug      String        @unique @db.VarChar(100)
  category  TopicCategory
  parentId  String?       @map("parent_id") @db.Uuid
  track     TestTrack     @default(ALL)
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent                Topic?                @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subtopics             Topic[]               @relation("TopicHierarchy")
  driveRoundTopics      DriveRoundTopic[]
  experienceRoundTopics ExperienceRoundTopic[]
  questions             Question[]            @relation("TopicQuestions")
  subtopicQuestions     Question[]            @relation("SubtopicQuestions")
  testSectionRules      TestSectionRule[]     @relation("RuleTopic")
  subtopicRules         TestSectionRule[]     @relation("RuleSubtopic")
  studentStats          StudentTopicStat[]
  roadmapTasks          RoadmapTask[]
  prepResources         PrepResource[]

  @@map("topics")
}

model PlacementSeason {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId  String   @map("college_id") @db.Uuid
  label      String   @db.VarChar(50)
  batchYear  Int      @map("batch_year")
  startDate  DateTime @map("start_date") @db.Timestamptz(6)
  endDate    DateTime @map("end_date") @db.Timestamptz(6)
  isCurrent  Boolean  @default(false) @map("is_current")
  rowVersion Int      @default(1) @map("row_version")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  drives  Drive[]

  @@unique([collegeId, label])
  @@unique([id, collegeId])
  @@index([collegeId])
  @@map("placement_seasons")
}

model Drive {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId            String        @map("college_id") @db.Uuid
  companyId            String        @map("company_id") @db.Uuid
  seasonId             String        @map("season_id") @db.Uuid
  title                String        @db.VarChar(255)
  description          String?       @db.Text
  driveType            DriveType     @default(ON_CAMPUS) @map("drive_type")
  category             DriveCategory @default(REGULAR)
  status               DriveStatus   @default(DRAFT)
  isHistorical         Boolean       @default(false) @map("is_historical")
  visitDate            DateTime?     @map("visit_date") @db.Timestamptz(6)
  registrationOpensAt  DateTime?     @map("registration_opens_at") @db.Timestamptz(6)
  registrationDeadline DateTime?     @map("registration_deadline") @db.Timestamptz(6)
  venue                String?       @db.VarChar(255)
  registeredCount      Int?          @map("registered_count")
  shortlistedCount     Int?          @map("shortlisted_count")
  selectedCount        Int?          @map("selected_count")
  createdBy            String?       @map("created_by") @db.Uuid
  rowVersion           Int           @default(1) @map("row_version")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  college        College           @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  season         PlacementSeason   @relation(fields: [seasonId, collegeId], references: [id, collegeId], onDelete: Restrict)
  roles          DriveRole[]
  eligibility    DriveEligibility?
  rounds         DriveRound[]
  applications   DriveApplication[]
  notices        Notice[]
  experiences    Experience[]
  consentRecords ConsentRecord[]
  roadmapTasks   RoadmapTask[]
  driveEvents    DriveEvent[]
  studentScores  StudentCompanyScore[]

  @@unique([id, collegeId])
  @@index([collegeId])
  @@index([companyId])
  @@index([seasonId])
  @@index([status])
  @@map("drives")
}

model DriveRole {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driveId        String    @map("drive_id") @db.Uuid
  collegeId      String    @map("college_id") @db.Uuid
  title          String    @db.VarChar(100)
  jobType        JobType   @default(FULL_TIME) @map("job_type")
  ctcLpaMin      Decimal   @map("ctc_lpa_min") @db.Decimal(6, 2)
  ctcLpaMax      Decimal   @map("ctc_lpa_max") @db.Decimal(6, 2)
  stipendMonthly Int?      @map("stipend_monthly")
  location       String?   @db.VarChar(100)
  openings       Int?
  bondMonths     Int?      @map("bond_months")
  description    String?   @db.Text
  rowVersion     Int       @default(1) @map("row_version")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  drive        Drive              @relation(fields: [driveId, collegeId], references: [id, collegeId], onDelete: Cascade)
  college      College            @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  skills       DriveRoleSkill[]
  applications DriveApplication[]

  @@unique([id, collegeId])
  @@index([collegeId])
  @@index([driveId])
  @@map("drive_roles")
}

model DriveRoleSkill {
  driveRoleId String   @map("drive_role_id") @db.Uuid
  skillId     String   @map("skill_id") @db.Uuid
  collegeId   String   @map("college_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  driveRole DriveRole @relation(fields: [driveRoleId, collegeId], references: [id, collegeId], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([driveRoleId, skillId])
  @@index([collegeId])
  @@map("drive_role_skills")
}

model DriveEligibility {
  driveId           String   @id @map("drive_id") @db.Uuid
  collegeId         String   @map("college_id") @db.Uuid
  minCgpa           Decimal? @map("min_cgpa") @db.Decimal(4, 2)
  maxActiveBacklogs Int?     @map("max_active_backlogs")
  allowedDegrees    Degree[] @default([]) @map("allowed_degrees")
  allowedBatchYears Int[]    @default([]) @map("allowed_batch_years")
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  drive            Drive                 @relation(fields: [driveId, collegeId], references: [id, collegeId], onDelete: Cascade)
  college          College               @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  eligibleBranches DriveEligibleBranch[]

  @@unique([driveId, collegeId])
  @@index([collegeId])
  @@map("drive_eligibilities")
}

model DriveEligibleBranch {
  driveId   String   @map("drive_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  collegeId String   @map("college_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  eligibility DriveEligibility @relation(fields: [driveId, collegeId], references: [driveId, collegeId], onDelete: Cascade)
  branch      Branch           @relation(fields: [branchId, collegeId], references: [id, collegeId], onDelete: Cascade)

  @@id([driveId, branchId])
  @@index([collegeId])
  @@map("drive_eligible_branches")
}

model DriveRound {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driveId         String    @map("drive_id") @db.Uuid
  collegeId       String    @map("college_id") @db.Uuid
  sequence        Int
  roundType       RoundType @map("round_type")
  title           String    @db.VarChar(100)
  durationMinutes Int?      @map("duration_minutes")
  difficulty      Int?
  mode            RoundMode @default(ONLINE)
  platformNote    String?   @map("platform_note") @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

