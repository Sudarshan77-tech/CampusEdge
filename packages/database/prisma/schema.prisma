  channel   NotificationChannel  @default(IN_APP)
  title     String               @db.VarChar(255)
  body      String               @db.Text
  linkUrl   String?              @map("link_url") @db.VarChar(500)
  readAt    DateTime?            @map("read_at") @db.Timestamptz(6)
  dedupeKey String?              @map("dedupe_key") @db.VarChar(255)
  metadata  Json                 @default("{}") @db.JsonB
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  college College?    @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([collegeId])
  @@index([dedupeKey])
  @@map("notifications")
}

model NotificationPreference {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  collegeId    String?              @map("college_id") @db.Uuid
  category     NotificationCategory
  inAppEnabled Boolean              @default(true) @map("in_app_enabled")
  emailEnabled Boolean              @default(true) @map("email_enabled")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  college College?    @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@map("notification_preferences")
}

model EmailOutbox {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String?              @map("user_id") @db.Uuid
  collegeId         String?              @map("college_id") @db.Uuid
  recipientEmail    String               @map("recipient_email") @db.VarChar(255)
  recipientName     String?              @map("recipient_name") @db.VarChar(255)
  category          NotificationCategory
  subject           String               @db.VarChar(255)
  bodyHtml          String               @map("body_html") @db.Text
  bodyText          String               @map("body_text") @db.Text
  status            EmailOutboxStatus    @default(PENDING)
  attempts          Int                  @default(0)
  maxAttempts       Int                  @default(3) @map("max_attempts")
  lastAttemptAt     DateTime?            @map("last_attempt_at") @db.Timestamptz(6)
  nextAttemptAt     DateTime?            @map("next_attempt_at") @db.Timestamptz(6)
  providerMessageId String?              @map("provider_message_id") @db.VarChar(255)
  lastError         String?              @map("last_error") @db.Text
  dedupeKey         String?              @map("dedupe_key") @db.VarChar(255)
  metadata          Json                 @default("{}") @db.JsonB
  sentAt            DateTime?            @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    UserProfile? @relation(fields: [userId], references: [id], onDelete: SetNull)
  college College?     @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([userId])
  @@index([collegeId])
  @@index([dedupeKey])
  @@map("email_outbox")
}

model CompanyProfile {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId               String          @unique @map("company_id") @db.Uuid
  sizeBand                CompanySizeBand @default(MID_SIZE) @map("size_band")
  primaryRoleFamily       RoleFamily      @default(SOFTWARE_DEV) @map("primary_role_family")
  overview                String?         @db.Text
  websiteUrl              String?         @map("website_url") @db.VarChar(500)
  logoUrl                 String?         @map("logo_url") @db.VarChar(500)
  hqCity                  String?         @map("hq_city") @db.VarChar(100)
  hqCountry               String?         @default("India") @map("hq_country") @db.VarChar(100)
  glassdoorRating         Float?          @map("glassdoor_rating")
  techStack               String[]        @default([]) @map("tech_stack")
  selectionProcessSummary String?         @map("selection_process_summary") @db.Text
  typicalRoundsCount      Int?            @default(3) @map("typical_rounds_count")
  ctcBreakupNote          String?         @map("ctc_breakup_note") @db.Text
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([sizeBand])
  @@index([primaryRoleFamily])
  @@map("company_profiles")
}

model EmailSuppression {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String                 @db.VarChar(255)
  reason    EmailSuppressionReason
  details   String?                @db.Text
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([email, reason])
  @@index([email])
  @@map("email_suppressions")
}

model WebhookEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String    @db.VarChar(50)
  eventId     String    @map("event_id") @db.VarChar(255)
  eventType   String    @map("event_type") @db.VarChar(100)
  payload     Json      @db.JsonB
  processed   Boolean   @default(false)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@index([processed])
  @@map("webhook_events")
}

