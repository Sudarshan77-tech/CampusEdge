model QuestionGroup {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope     ContentScope @default(COLLEGE)
  collegeId String?      @map("college_id") @db.Uuid
  title     String       @db.VarChar(255)
  body      String       @db.Text
  imagePath String?      @map("image_path") @db.VarChar(500)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  college   College?     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([id, collegeId])
  @@map("question_groups")
}

model Question {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope               ContentScope   @default(COLLEGE)
  collegeId           String?        @map("college_id") @db.Uuid
  topicId             String         @map("topic_id") @db.Uuid
  subtopicId          String?        @map("subtopic_id") @db.Uuid
  type                QuestionType   @default(MCQ_SINGLE)
  difficulty          Int            @default(3)
  groupId             String?        @map("group_id") @db.Uuid
  status              QuestionStatus @default(DRAFT)
  currentVersionId    String?        @map("current_version_id") @db.Uuid
  source              QuestionSource @default(AUTHORED)
  licenseNote         String?        @map("license_note") @db.Text
  textHash            String         @map("text_hash") @db.VarChar(64)
  needsHumanReview    Boolean        @default(true) @map("needs_human_review")
  reviewedBy          String?        @map("reviewed_by") @db.Uuid
  reviewedAt          DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  expectedTimeSeconds Int            @default(60) @map("expected_time_seconds")
  tags                String[]       @default([])
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  college              College?              @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  topic                Topic                 @relation("TopicQuestions", fields: [topicId], references: [id], onDelete: Restrict)
  subtopic             Topic?                @relation("SubtopicQuestions", fields: [subtopicId], references: [id], onDelete: SetNull)
  group                QuestionGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  currentVersion       QuestionVersion?      @relation("QuestionCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  reviewer             UserProfile?          @relation("QuestionReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  versions             QuestionVersion[]     @relation("QuestionVersionsList")
  stats                QuestionStat?
  reports              QuestionReport[]
  bookmarks            QuestionBookmark[]
  testSectionQuestions TestSectionQuestion[]
  attemptItems         AttemptItem[]

  @@unique([id, collegeId])
  @@index([textHash])
  @@index([topicId])
  @@index([subtopicId])
  @@index([status])
  @@index([collegeId])
  @@map("questions")
}

model QuestionVersion {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId       String   @map("question_id") @db.Uuid
  version          Int      @default(1)
  stem             String   @db.Text
  imagePath        String?  @map("image_path") @db.VarChar(500)
  explanation      String   @db.Text
  numericAnswer    Float?   @map("numeric_answer")
  numericTolerance Float?   @default(0) @map("numeric_tolerance")
  createdBy        String?  @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  question          Question         @relation("QuestionVersionsList", fields: [questionId], references: [id], onDelete: Cascade)
  currentOfQuestion Question[]       @relation("QuestionCurrentVersion")
  author            UserProfile?     @relation("QuestionVersionAuthor", fields: [createdBy], references: [id], onDelete: SetNull)
  options           QuestionOption[]
  attemptItems      AttemptItem[]

  @@unique([questionId, version])
  @@map("question_versions")
}

