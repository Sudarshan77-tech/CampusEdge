{
  "name": "@campusedge/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\" && prettier --check \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "test": "tsx --test \"prisma/**/*.spec.ts\"",
    "db:generate": "dotenv -e ../../apps/api/.env.local -- prisma generate",
    "db:migrate:dev": "dotenv -e ../../apps/api/.env.local -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../apps/api/.env.local -- prisma migrate deploy",
    "db:migrate:deploy:remote": "dotenv -e ../../apps/api/.env -- prisma migrate deploy",
    "db:migrate:resolve": "dotenv -e ../../apps/api/.env -- prisma migrate resolve",
    "db:migrate:resolve:local": "dotenv -e ../../apps/api/.env.local -- prisma migrate resolve",
    "db:diff": "dotenv -e ../../apps/api/.env -- prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script",
    "db:seed": "dotenv -e ../../apps/api/.env.local -- tsx prisma/seed.ts",
    "db:seed:remote": "dotenv -e ../../apps/api/.env -- tsx prisma/seed.ts",
    "db:reset": "dotenv -e ../../apps/api/.env.local -- prisma migrate reset",
    "db:verify-rls": "dotenv -e ../../apps/api/.env.local -- tsx prisma/verify-rls.ts",
    "db:verify-rls:remote": "dotenv -e ../../apps/api/.env -- tsx prisma/verify-rls.ts",
    "db:test-rls": "dotenv -e ../../apps/api/.env.local -- tsx prisma/test-rls.ts",
    "db:test-rls:remote": "dotenv -e ../../apps/api/.env -- tsx prisma/test-rls.ts",
    "db:seed:dev-users": "dotenv -e ../../apps/api/.env.local -- tsx prisma/seed-dev-users.ts",
    "db:seed:dev-users:remote": "dotenv -e ../../apps/api/.env -- tsx prisma/seed-dev-users.ts",
    "db:seed:demo-intelligence": "dotenv -e ../../apps/api/.env.local -- tsx prisma/seed-demo-intelligence.ts",
    "db:seed:demo-intelligence:remote": "dotenv -e ../../apps/api/.env -- tsx prisma/seed-demo-intelligence.ts",
    "content:generate": "tsx seed-content/generate.ts",
    "content:validate": "tsx prisma/validate-content.ts",
    "content:seed:dev": "dotenv -e ../../apps/api/.env.local -- tsx prisma/seed-starter-questions.ts",
    "content:seed:remote": "dotenv -e ../../apps/api/.env -- tsx prisma/seed-starter-questions.ts",
    "storage:setup": "dotenv -e ../../apps/api/.env -- tsx prisma/setup-storage.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@supabase/supabase-js": "^2.117.3"
  },
  "devDependencies": {
    "@campusedge/config": "workspace:*",
    "@types/node": "^22.13.9",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
