# API Service Environment Variables
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Supabase PostgreSQL Connection Pooler (Runtime vs Migrations)
# Transaction pooler (port 6543) for runtime queries
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler / Direct connection (port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth & Service Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-or-leave-empty-for-jwks

# AI Integration (Empty for Phase 0)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Worker Queue (Empty for Phase 0)
REDIS_URL=
