{
  "name": "campusedge-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "turbo run dev",
    "dev:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-clean.ps1",
    "ports:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ports-check.ps1",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @campusedge/database db:generate",
    "db:migrate:dev": "pnpm --filter @campusedge/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @campusedge/database db:migrate:deploy",
    "db:migrate:deploy:remote": "pnpm --filter @campusedge/database db:migrate:deploy:remote",
    "db:seed": "pnpm --filter @campusedge/database db:seed",
    "db:seed:remote": "pnpm --filter @campusedge/database db:seed:remote",
    "db:reset": "pnpm --filter @campusedge/database db:reset",
    "db:verify-rls": "pnpm --filter @campusedge/database db:verify-rls",
    "db:verify-rls:remote": "pnpm --filter @campusedge/database db:verify-rls:remote",
    "db:test-rls": "pnpm --filter @campusedge/database db:test-rls",
    "db:test-rls:remote": "pnpm --filter @campusedge/database db:test-rls:remote",
    "db:seed:dev-users": "pnpm --filter @campusedge/database db:seed:dev-users",
    "db:seed:demo-intelligence": "pnpm --filter @campusedge/database db:seed:demo-intelligence",
    "content:generate": "pnpm --filter @campusedge/database content:generate",
    "content:validate": "pnpm --filter @campusedge/database content:validate",
    "content:seed:dev": "pnpm --filter @campusedge/database content:seed:dev",
    "storage:setup": "pnpm --filter @campusedge/database storage:setup",
    "perf:attempts": "pnpm --filter @campusedge/database perf:attempts",
    "smoke-test": "pnpm --filter @campusedge/database exec tsx ../../scripts/production-smoke-test.ts",
    "admin:create-super-admin": "pnpm --filter @campusedge/api admin:create-super-admin",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "supabase": "^2.120.0",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.1"
  }
}
